# ---- Backend (server) ----
# Questathon MCP endpoint (from the Questathon CONNECT page)
MCP_URL=https://questathon.aihackerscollective.com/api/public/mcp
# Your personal token. NEVER commit it. Server-side only.
AQ_TOKEN=replace-with-your-token
# Header used to send the token. Check the CONNECT page; Bearer is the default.
MCP_AUTH_HEADER=Authorization
MCP_AUTH_SCHEME=Bearer
# Seconds between MCP calls. Hard floor is 65 (API limit is 1 call/min).
MIN_INTERVAL_SECONDS=65
# Secret required for sync / write routes. Set a long random string.
ADMIN_KEY=replace-with-a-long-random-string
# Comma-separated allowed browser origins (your Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
PORT=8787
DATA_DIR=./data
# Optional: set to 1 to auto-run the initial sync on boot if cache is empty
AUTO_SYNC_ON_BOOT=0

# ---- Frontend (web) ----
# Put in web/.env.local or Vercel project settings (not secret)
VITE_API_URL=http://localhost:8787
